  "achats": [
    {
      "poste": "Panneaux sandwich 60 mm - finition MUR (murs + rehausse)",
      "qte": "10 panneaux de 2.15 m + 1 de 2.40 m (~26.3 m2 avec chute)",
      "note": "Ame PIR, autoportants (pas d'ossature). Parement mural lisse/micro-nervure, laque 2 faces. Coupes droites + 1 diagonale."
    },
    {
      "poste": "Panneaux sandwich 60 mm - finition TOIT (face T)",
      "qte": "3 panneaux de ~2.61 m (~8.6 m2 avec chute)",
      "note": "Profil TOITURE (nervures hautes), sens de la pente. Portee libre ~2.60 m : verifier le tableau de portees du fabricant."
    },
    {
      "poste": "Rail / lambourde de pied",
      "qte": "~10 m",
      "note": "U galvanise OU bois traite classe 4, sur bande EPDM. Sureleve les panneaux de la dalle."
    },
    {
      "poste": "Profils d'angle exterieurs + interieurs",
      "qte": "4 angles x 2.40 m, ext + int = ~20 m",
      "note": "4 angles droits standard (profil L / couvre-joint)."
    },
    {
      "poste": "Bavette d'egout haut (avant)",
      "qte": "~3 m",
      "note": "Larmier en haut de la face avant."
    },
    {
      "poste": "Bavettes de rive (gauche/droite)",
      "qte": "~6 m",
      "note": "Rives laterales du toit, avec debord."
    },
    {
      "poste": "Gouttiere + 1 descente",
      "qte": "~3 m + 1 descente",
      "note": "En bas de pente (face B), descente a un angle arriere."
    },
    {
      "poste": "Vis autoperceuses tete EPDM",
      "qte": "~191 (boite de 200)",
      "note": "Longueur = epaisseur panneau + rail. Rondelle d'etancheite obligatoire."
    },
    {
      "poste": "Chevilles / scellement dalle",
      "qte": "~18",
      "note": "Fixation du rail de pied sur la dalle beton (tous les ~50 cm)."
    },
    {
      "poste": "Porte vitree alu double vitrage",
      "qte": "1 (90x210 cm)",
      "note": "Source principale de lumiere. Ouverture vers l'exterieur. Dormant + seuil + joints."
    },
    {
      "poste": "Fenetre(s) double vitrage",
      "qte": "1 : 80x80 all.110 (face D)",
      "note": "allege = hauteur sous fenetre (cm). Fixe ou oscillo-battant. La garder dans un seul panneau (pas a cheval sur un joint). Cadre + appui + joints."
    },
    {
      "poste": "Ventilation (VMC ou aerateurs hygro)",
      "qte": "1 kit",
      "note": "INDISPENSABLE en usage habitable chauffe : evite la condensation (voir vigilance)."
    },
    {
      "poste": "Bande comprimee / mousse precomprimee",
      "qte": "~18 m",
      "note": "Etancheite a l'air au pied et au pourtour des ouvertures."
    },
    {
      "poste": "Bande butyle (joints de panneaux)",
      "qte": "~18 m",
      "note": "Joints longitudinaux, joint mur/rehausse et perimetriques."
    },
    {
      "poste": "Mastic PU + primaire anticorrosion",
      "qte": "~5 cartouches + 1 primaire",
      "note": "Cachetage et protection des chants coupes (anticorrosion)."
    },
    {
      "poste": "Peinture de retouche (RAL parement)",
      "qte": "1 aerosol",
      "note": "Retouche des rayures et chants."
    }
  ],
