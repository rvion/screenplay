  "achats": [
    {
      "poste": "Panneaux sandwich 60 mm - finition MUR",
      "qte": "9 panneaux de 2.15 m (~21.3 m2 avec chute)",
      "note": "Ame PIR, autoportants (pas d'ossature). FIXATION CACHEE dans le joint (pas de tete de vis visible), parement lisse/micro-nervure, couleur au choix (mur fonce + toit clair). Coupes droites uniquement."
    },
    {
      "poste": "Rehausse bois : madrier 75x225 mm traite classe 4",
      "qte": "1 x 4.80 m (4.4 ml : R1 = 200 cm droit, R2+R3 = 240 cm coupe en diagonale)",
      "note": "Pose sur le chant des panneaux (bande butyle), visse dans les panneaux ; sert de lisse haute qui lie murs et toit. Larmier par-dessus cote exterieur."
    },
    {
      "poste": "Panneaux sandwich 60 mm - finition TOIT (face T)",
      "qte": "2 panneaux de ~2.61 m (~5.7 m2 avec chute)",
      "note": "Profil TOITURE (nervures hautes), sens de la pente, COULEUR CLAIRE (chaleur d'ete). Portee libre ~2.60 m : verifier le tableau de portees du fabricant."
    },
    {
      "poste": "Rail / lambourde de pied",
      "qte": "~10 m",
      "note": "U galvanise OU bois traite classe 4, sur bande EPDM. Sureleve les panneaux de la dalle."
    },
    {
      "poste": "Profils d'angle exterieurs + interieurs",
      "qte": "4 angles x 2.38 m, ext + int = ~19 m",
      "note": "4 angles droits standard (profil L / couvre-joint)."
    },
    {
      "poste": "Bavette d'egout haut (avant)",
      "qte": "~3 m",
      "note": "Larmier en haut de la face avant."
    },
    {
      "poste": "Bavettes de rive (gauche/droite)",
      "qte": "~6 m",
      "note": "Rives laterales du toit (affleurantes si debord lateral = 0 : la bavette ferme le chant du panneau)."
    },
    {
      "poste": "Gouttiere + 1 descente",
      "qte": "~3 m + 1 descente",
      "note": "En bas de pente (face B), descente a un angle arriere."
    },
    {
      "poste": "Vis autoperceuses tete EPDM",
      "qte": "~148 (boite de 200)",
      "note": "Longueur = epaisseur panneau + rail. Rondelle d'etancheite obligatoire."
    },
    {
      "poste": "Chevilles / scellement dalle",
      "qte": "~18",
      "note": "Fixation du rail de pied sur la dalle beton (tous les ~50 cm)."
    },
    {
      "poste": "Bloc-porte vitre alu double vitrage",
      "qte": "1 (100x215 cm)",
      "note": "Dormant compris, aux cotes d'un module entier (largeur utile x hauteur de mur) : remplace un panneau, rien a decouper. Poignee + serrure, ouverture vers l'exterieur, seuil + joints. La piece touchee tous les jours : ne pas economiser ici."
    },
    {
      "poste": "Fenetre(s) double vitrage",
      "qte": "2 : 80x110 all.95 (face D, oscillo-battante), 80x110 all.95 (face G, fixe)",
      "note": "allege = hauteur sous fenetre (cm). L'ouvrante assure la ventilation traversante avec la porte. Chaque fenetre dans un seul panneau (pas a cheval sur un joint). Cadre + appui + joints."
    },
    {
      "poste": "Ventilation (VMC ou aerateurs hygro)",
      "qte": "1 kit",
      "note": "INDISPENSABLE en usage habitable chauffe : evite la condensation (voir vigilance)."
    },
    {
      "poste": "Bande comprimee / mousse precomprimee",
      "qte": "~23 m",
      "note": "Etancheite a l'air au pied et au pourtour des ouvertures."
    },
    {
      "poste": "Bande butyle (joints de panneaux)",
      "qte": "~18 m",
      "note": "Joints longitudinaux, joint mur/rehausse et perimetriques."
    },
    {
      "poste": "Mastic PU + primaire anticorrosion",
      "qte": "~5 cartouches + 1 primaire",
      "note": "Cachetage et protection des chants coupes (anticorrosion)."
    },
    {
      "poste": "Peinture de retouche (RAL parement)",
      "qte": "1 aerosol",
      "note": "Retouche des rayures et chants."
    },
    {
      "poste": "Plancher isole",
      "qte": "~4.29 m2, 6 cm",
      "note": "plancher isole : lambourdes + 40 mm d'isolant + OSB + sol vinyle/parquet. Hauteur sous plafond arriere ~2.09 m."
    },
    {
      "poste": "Electricite (cable existant par le sol)",
      "qte": "1 lot",
      "note": "cable existant par le sol : multiprise parafoudre + plafonnier LED + chemins de cable"
    },
    {
      "poste": "Chauffage",
      "qte": "1",
      "note": "radiateur panneau 750 W avec thermostat"
    },
    {
      "poste": "Store / occultation",
      "qte": "1",
      "note": "store sur la porte vitree (soleil / ecran)"
    },
    {
      "poste": "Finition interieure",
      "qte": "1 lot",
      "note": "couvre-joints d'angle interieurs, tapis, rideau (acoustique)"
    }
